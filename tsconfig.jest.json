{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "module": "es2022",
    "target": "es2022",
    "moduleResolution": "node"
  },
  "ts-node": {
    "esm": true,
    "compilerOptions": {
      "module": "es2022",
      "target": "es2022"
    }
  }
}
